# ── 必填 ────────────────────────────────────────────────────────────────
# 访问密码（不设置时站点会提示管理员配置后再可用）
PASSWORD=change-me

# ── 会话与代理 ─────────────────────────────────────────────────────────
# 会话/代理签名密钥；不设置时从 PASSWORD 派生（多实例部署建议显式设置：openssl rand -hex 32）
# PROXY_SECRET=

# Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 代理上游请求超时（毫秒）与重试次数
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 代理请求 UA（豆瓣封面防盗链等场景），默认 Chrome UA
# USER_AGENT=

# 豆瓣推荐数据直连被拒时降级使用的 CORS 代理
# FALLBACK_CORS_PROXY=

# ── 搜索 ───────────────────────────────────────────────────────────────
# 每个搜索源最多抓取的页数（1-50，默认 5）
# SEARCH_MAX_PAGES=5

# 单个搜索源的总死线（毫秒，3000-60000，默认 15000）
# SEARCH_SOURCE_TIMEOUT_MS=15000

# ── 预置数据（首次访问自动导入，用户删除后不再自动加回） ────────────────
# 点播源（Apple CMS 采集站）
# DEFAULT_SOURCES=[{"name":"示例源","url":"https://example.com/api.php/provide/vod"}]

# 直播源（M3U 订阅，epg 可选）
# DEFAULT_LIVE_SOURCES=[{"name":"示例直播源","url":"https://example.com/list.m3u","epg":"https://example.com/epg.xml.gz"}]

# 数据源订阅（LibreTV-SourceList JSON 链接，也接受 TVBOX 配置地址）
# DEFAULT_SUBSCRIPTIONS=["https://example.com/sources.json"]

# ── 默认值（仅对未被用户主动改过的项生效） ─────────────────────────────
# 首页推荐数据源：douban / bangumi / hot-list（出厂 douban）
# DEFAULT_RECOMMEND_SOURCE=douban

# 封面图加载方式：direct（原站直连优先，省服务器流量，出厂值）/ proxy（内置代理优先，最稳定）
# DEFAULT_IMAGE_MODE=direct

# ── 直播 ───────────────────────────────────────────────────────────────
# 设为 1 时允许直播流代理访问内网/保留地址（自建内网 IPTV 场景），默认关闭以维持 SSRF 防护
# LIVE_ALLOW_PRIVATE=1

# ── 推荐源 ─────────────────────────────────────────────────────────────
# 影视榜单推荐源（60s API）实例地址，默认 https://60s.crystelf.top，请求失败自动回退公共实例 https://60s.viki.moe
# 公共实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.crystelf.top

# ── 部署 ───────────────────────────────────────────────────────────────
# 固定使用某个发布镜像版本（不设置 = ghcr.io/zhifansong/better-libretv:latest）
# 首次部署先 docker compose pull 拉取；本地开发可用 docker compose up -d --build 构建
# LIBRETV_IMAGE=ghcr.io/zhifansong/better-libretv:2.16.12
